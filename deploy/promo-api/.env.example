# promo-api — copy to .env, chmod 600. Every secret here stays on JODA except
# PROMO_AGENT_TOKEN, which also goes to the Spark (deploy/spark/promo.env).

# Agent token: read + drafts + inbox. `openssl rand -hex 32`
PROMO_AGENT_TOKEN=
# Admin token: approve/edit/reject. Never copy it to the Spark. `openssl rand -hex 32`
PROMO_ADMIN_TOKEN=

# Host directory for promo.db, assets/ and the bot's update offset (owned by uid 1000).
PROMO_DATA_DIR=./data
# Address the API is published on (LAN).
PROMO_BIND=192.168.88.88

# Slot rules: timezone, daily posting window, minimum lead between approval and publication.
PROMO_TZ=Europe/Prague
PROMO_POST_WINDOW=09:00-20:00
PROMO_POST_LEAD=10m

# Telegram approval bot — a SECOND bot, not the OpenClaw one (a bot token can
# have only one poller). Token from @BotFather; your numeric id from @userinfobot.
TELEGRAM_APPROVAL_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Defaults to the only allowed user's private chat.
TELEGRAM_APPROVAL_CHAT_ID=

# Postiz Public API. Base URL ends in /api/public/v1; the key comes from
# Postiz → Settings → Developers → Public API.
#   Postiz on the Spark: http://192.168.88.66:4007/api/public/v1
#   Postiz on JODA:      http://192.168.88.88:4007/api/public/v1
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Link shown in "scheduled" notifications.
POSTIZ_UI_URL=https://postiz.ol1n.com
# Only needed with several channels per platform: bluesky=<id>,x=<id>,youtube=<id>
# (`docker compose exec promo-api promo-api check` lists the ids).
POSTIZ_INTEGRATIONS=
PROMO_PUBLISH_INTERVAL=5m
PROMO_SYNC_INTERVAL=5m
PROMO_YOUTUBE_PRIVACY=public
PROMO_X_WHO_CAN_REPLY=everyone

# Optional: secret for POST /webhooks/postiz?secret=… (needs a public hostname;
# status is polled anyway).
PROMO_WEBHOOK_SECRET=

# Reddit asks for stored user content to be dropped within 48 h.
PROMO_REDDIT_RETENTION=48h
