# Postiz — copy to .env, chmod 600.

# Public URL: browser, OAuth callbacks and the media URLs Postiz fetches when publishing.
POSTIZ_URL=https://social.ol1n.com
POSTIZ_VERSION=latest

POSTIZ_JWT_SECRET=          # openssl rand -hex 48 (changing it logs everyone out)
POSTIZ_DB_PASSWORD=         # openssl rand -hex 24
TEMPORAL_DB_PASSWORD=       # openssl rand -hex 24

# Address the Public API is published on for promo-api's publisher.
#   Postiz on the Spark, promo-api on JODA: 192.168.88.66
#   both on one host:                      127.0.0.1
POSTIZ_BIND=192.168.88.66

# Registration is open until you create your account. Then set true and
# `docker compose up -d` again — the UI is reachable from the LAN.
POSTIZ_DISABLE_REGISTRATION=false
POSTIZ_API_LIMIT=90

# X developer app: OAuth 1.0a, Read and Write, type "Native App",
# callback https://social.ol1n.com/integrations/social/x
X_API_KEY=
X_API_SECRET=

# Google Cloud OAuth client (Web application), YouTube Data API v3 enabled,
# redirect URI https://social.ol1n.com/integrations/social/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Bluesky needs no env: add the channel in the UI with an app password.
