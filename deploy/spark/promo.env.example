# ~/.config/promoclown/promo.env on the Spark (chmod 600).
# Loaded into the OpenClaw gateway by the systemd drop-in, so the skills and
# the commands the agent runs see it, and by the PROJECTS.md refresh timer.
# Only read-only credentials belong here.

PROMO_API_URL=http://192.168.88.88:8094
# PROMO_AGENT_TOKEN from JODA. Never the admin token.
PROMO_TOKEN=

# store-reviews: App Store Connect team API key, role Customer Support.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=/home/ol1n/.config/promoclown/AuthKey.p8
# Comma-separated App Store Connect app ids (the number in the App Store URL).
ASC_APP_IDS=
# store-metrics uses the same ASC_* variables, but Sales and Trends and the
# Analytics Reports need the "Sales and Reports" role: generate the key with
# that role instead of Customer Support (it still reads reviews). Vendor number:
# App Store Connect → Payments and Financial Reports, top left.
ASC_VENDOR_NUMBER=

# store-reviews: Google Play service account invited in Play Console with
# "Reply to reviews" (the reviews API requires it; the key still only reads).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/home/ol1n/.config/promoclown/play-service-account.json
GOOGLE_PLAY_PACKAGES=

# youtube-comments: API key restricted to YouTube Data API v3; channel id starts with UC.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# bluesky-mentions: app password (Settings → Privacy and security → App passwords).
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# reddit-monitor: unused. Reddit refused API access for this use (Responsible
# Builder Policy, 2026-10), so nothing calls it. Leave all five empty: a
# half-filled set makes the CLI fail instead of skip.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
