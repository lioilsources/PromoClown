[Unit]
Description=PromoClown: drain the tribute queue before midnight

[Timer]
# 16:30 is the end of the comfy window (07:00-17:00 in rag-schedule.sh,
# AiStack/PLAN-spark-scheduler.md since 2026-10-01). At 17:00 ComfyUI is
# stopped for the LLM profile, so a run started later would find no GPU.
OnCalendar=*-*-* 16:30:00
Persistent=true

[Install]
WantedBy=timers.target
