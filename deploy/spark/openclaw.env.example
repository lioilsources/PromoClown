# ~/.config/promoclown/openclaw.env on the Spark (chmod 600).
# Substituted into ~/.openclaw/openclaw.json via ${VAR}.

# `openssl rand -hex 32`; also keep it in the password manager (dashboard login).
OPENCLAW_GATEWAY_TOKEN=
# The agent's bot from @BotFather, e.g. @ol1n_promo_bot. NOT the approval bot.
TELEGRAM_AGENT_BOT_TOKEN=
# Your numeric Telegram user id (@userinfobot). The only account the bots obey.
TELEGRAM_OWNER_ID=
