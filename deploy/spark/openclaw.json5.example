// ~/.openclaw/openclaw.json for PromoClown on the DGX Spark (JSON5).
//
// OpenClaw rewrites this file as plain JSON whenever it changes a setting, so
// this commented copy is the reference. Keys change between releases: after
// installing, check with `openclaw doctor` and `openclaw config --help`
// (written against OpenClaw 2026.9.x docs).
{
  models: {
    mode: "merge",
    providers: {
      litellm: {
        // AiStack gateway (:8080, host) → LiteLLM route "openclaw-default" →
        // vLLM "qwen36-agent". LiteLLM's own :4000 is not published to the host.
        baseUrl: "http://127.0.0.1:8080/v1",
        apiKey: "dummy",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "openclaw-default",
            name: "Qwen3.6-35B-A3B NVFP4 (vLLM on Spark)",
            // Thinking is switched off in LiteLLM (chat_template_kwargs): thinking
            // blocks confuse tool calling.
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 65536, // = vLLM --max-model-len
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: { primary: "litellm/openclaw-default" },
      thinkingDefault: "off",
      userTimezone: "Europe/Prague",
      models: {
        "litellm/openclaw-default": {
          // If the model starts inventing tool arguments, drop to 0.2 (plan §8).
          params: { temperature: 0.6 },
        },
      },
      heartbeat: {
        every: "15m",
        target: "telegram",
        to: "${TELEGRAM_OWNER_ID}",
        activeHours: { start: "07:30", end: "22:30", timezone: "Europe/Prague" },
        lightContext: true,
        isolatedSession: true,
        timeoutSeconds: 300,
      },
    },
  },

  // Loopback only. Web UI from the Mac: ssh -L 18789:127.0.0.1:18789 spark
  gateway: {
    mode: "local",
    port: 18789,
    bind: "loopback",
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_AGENT_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
      groupPolicy: "disabled",
    },
  },
  commands: { ownerAllowFrom: ["telegram:${TELEGRAM_OWNER_ID}"] },

  tools: {
    profile: "coding",
    // No web, browser, screen or remote nodes: the agent works from promo data only.
    deny: ["group:web", "group:ui", "group:nodes"],
    // Shell runs only binaries on the approvals allowlist (setup-openclaw.sh
    // adds the PromoClown CLIs); everything else is silently denied.
    exec: { host: "gateway", mode: "allowlist" },
  },
}
